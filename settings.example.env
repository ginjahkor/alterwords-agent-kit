# settings.example.env - copy this to settings.env and fill it in for YOUR agent.
#   cp settings.example.env settings.env
# settings.env is in .gitignore: it never goes back to the repo.
# Plain KEY=value lines only (no spaces around =). Both bash and Python read this file.
# NEVER put a real key in settings.example.env. Keys go in settings.env or in ~/.config/<tool>/ files.

# ---------- Who you are ----------
AGENT_NAME="Your Agent Name"          # shown in on-screen credits and look names
AGENT_SLUG=youragent                   # short, lowercase, no spaces: used in file names
AGENT_LANG=en                          # main spoken language (Whisper hint: en, yo, ha, ig, fr...)

# ---------- Where things live ----------
# KIT_HOME is found automatically (the folder this file sits in). Change the rest if you like.
AGENT_HOME=$HOME/agent_studio          # your working folder: renders, posts, looks, logs
AGENT_WORK=$AGENT_HOME/work            # one sub-folder per video
AGENT_POSTS=$AGENT_HOME/posts          # Buffer post records + posts/index.csv
AGENT_LOOKS=$AGENT_HOME/looks          # avatar looks + catalog.json (avatar route only)
AGENT_MODELS=$AGENT_HOME/models        # face/hand/object models downloaded by install.sh
TOOLS_DIR=$HOME/tools                  # WARP tunnel + PO-token server (install.sh puts them here)

# ---------- Social handles (public names only, no logins) ----------
AGENT_TIKTOK_HANDLE=your_tiktok_handle
AGENT_IG_HANDLE=your_instagram_handle
AGENT_X_HANDLE=your_x_handle
# Buffer sometimes returns an old TikTok handle or a numeric X account number in post links.
# If yours does, put them here and buffer_post.sh rewrites the link. Leave empty if not.
AGENT_BUFFER_TIKTOK_OLD_HANDLE=
AGENT_X_ACCOUNT_NUMBER=

# ---------- Buffer (the ONLY way to post or read stats - RULE 0) ----------
# Find these with: buffer channels list --output json   (after you add your own Buffer key)
AGENT_BUFFER_ORG=
AGENT_BUFFER_CHANNEL=                  # TikTok channel id
AGENT_BUFFER_IG=                       # Instagram channel id
AGENT_BUFFER_X=                        # X channel id

# ---------- Look and brand ----------
AGENT_ACCENT="#ffd400"                 # highlight colour: pill, active caption word, progress bar
AGENT_INK="#ffffff"                    # main text colour
AGENT_BG="#0b0b0f"                     # card background
AGENT_FONT_DISPLAY="Archivo Black"     # titles (Google Font name)
AGENT_FONT_BODY="Montserrat"           # captions and pill
AGENT_CAPTION_STYLE=word               # word = one word lights up at a time; line = whole line, no highlight
AGENT_CAPTION_POSITION=lower           # lower | middle (middle when a face fills the lower third)
AGENT_BANNER_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# ---------- Voice ----------
# Agents WITHOUT a face: generated voiceover (see PRODUCTION_GUIDE.md, "Voiceover").
AGENT_TTS_PROVIDER=none                # minimax | gemini | none   (none until the owner gives you a key)
AGENT_TTS_VOICE=                       # ONE voice name/id, the same for every video
AGENT_TTS_SPEED=1.0
AGENT_TTS_STYLE="warm, conversational, Nigerian English, medium pace"
# Agents WITH an avatar: HeyGen voice id.
AGENT_VOICE_ID=

# ---------- Avatar (leave as none until the owner gives you one) ----------
AGENT_AVATAR_ID=none                   # HeyGen avatar / main look id, or none (free route)
AGENT_REF_LOOK_ID=                     # look id used as the identity reference for new looks
AGENT_REF_IMAGE=                       # path to your main close-up picture (face_check.py compares against it)
AGENT_MIN_CREDITS=40                   # render_avatar.sh refuses to render below this balance

# ---------- Keys: placeholders only. Fill in settings.env, never here. ----------
BUFFER_API_KEY=
MINIMAX_API_KEY=
GEMINI_API_KEY=
# HeyGen: sign in with the heygen CLI (OAuth), see PRODUCTION_GUIDE.md. No key line needed.
